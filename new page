            <div class="slider-dots" id="sliderDots">
                <span class="dot active" data-index="0"></span>
                <span class="dot" data-index="1"></span>
                <span class="dot" data-index="2"></span>
                <span class="dot" data-index="3"></span>
                <span class="dot" data-index="4"></span>
            </div>
        </section>

        <!-- Slide 2: Zen Landscape - taller -->
        <div class="zen-slide">
            <svg width="100%" height="100%" viewBox="0 0 1600 1000" preserveAspectRatio="none" style="background: #d4cfc8;">
                <!-- Zen Landscape SVG -->
                <rect width="1600" height="1000" fill="#e8e4de"/>
                
                <defs>
                    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" style="stop-color:#d4cfc8;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#e8e4de;stop-opacity:1" />
                    </linearGradient>
                    <linearGradient id="mountainGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" style="stop-color:#b8b0a6;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#c8c0b6;stop-opacity:1" />
                    </linearGradient>
                    <linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" style="stop-color:#c8c0b6;stop-opacity:0.6" />
                        <stop offset="100%" style="stop-color:#d4cfc8;stop-opacity:0.3" />
                    </linearGradient>
                </defs>
                
                <rect width="1600" height="1000" fill="url(#skyGrad)"/>
                <circle cx="1200" cy="220" r="65" fill="#d4cfc8" opacity="0.4"/>
                <circle cx="1200" cy="220" r="45" fill="#ccc4ba" opacity="0.3"/>
                
                <path d="M0 550 L100 420 L250 460 L400 380 L550 440 L700 390 L850 430 L1000 370 L1150 410 L1300 360 L1450 400 L1600 380 L1600 600 L0 600 Z" fill="#c8c0b6" opacity="0.5"/>
                <path d="M0 600 L80 470 L200 510 L350 440 L500 490 L650 430 L800 480 L950 420 L1100 470 L1250 410 L1400 460 L1550 420 L1600 440 L1600 700 L0 700 Z" fill="url(#mountainGrad)"/>
                <path d="M0 660 L200 620 L400 640 L600 610 L800 630 L1000 600 L1200 620 L1400 600 L1600 620 L1600 770 L0 770 Z" fill="#bab2a8" opacity="0.4"/>
                
                <ellipse cx="400" cy="790" rx="320" ry="65" fill="url(#waterGrad)"/>
