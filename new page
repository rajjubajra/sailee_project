    <script>
        const header = document.getElementById('header');
        let timeout;

        window.addEventListener('scroll', function() {
            const scrollY = window.scrollY;

            if (scrollY > 20) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }

            clearTimeout(timeout);

            if (scrollY > 20) {
                timeout = setTimeout(function() {
                    header.classList.remove('scrolled');
                }, 300);
            }
        });

        // Home link functionality
        const homeLink = document.getElementById('homeLink');
        homeLink.addEventListener('click', function(e) {
            e.preventDefault();
            window.open('#home', '_blank');
        });

        // Email functionality
        const emailElement = document.getElementById('emailLink');
        let emailClicked = false;

        emailElement.addEventListener('click', function(e) {
            e.preventDefault();
            emailClicked = !emailClicked;
            
            if (emailClicked) {
                this.classList.add('vermillion');
                window.open('mailto:OFSAEILY@GMAIL.COM', '_blank');
            } else {
                this.classList.remove('vermillion');
            }
        });

        // Navigation items functionality
        const navItems = document.querySelectorAll('.nav li');
        const navItemStates = {};

        navItems.forEach(function(item) {
            navItemStates[item.textContent.trim()] = false;
            
            item.addEventListener('click', function(e) {
                const key = this.textContent.trim();
                navItemStates[key] = !navItemStates[key];
                
                if (navItemStates[key]) {
                    this.classList.add('vermillion');
                    const page = this.getAttribute('data-page');
                    window.open(`#${page}`, '_blank');
                } else {
                    this.classList.remove('vermillion');
                }
            });
        });

        // Blog title links functionality
        document.querySelectorAll('.blog-link').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const title = this.textContent;
                window.open(`#${title.toLowerCase().replace(/\s+/g, '-')}`, '_blank');
            });
        });

        // Read more link functionality
        document.getElementById('readMoreAbout').addEventListener('click', function(e) {
            e.preventDefault();
            window.open('#about', '_blank');
        });

        // Slider scroll with dot indicators
        const container = document.getElementById('sliderContainer');
        const dots = document.querySelectorAll('.dot');
        let currentIndex = 0;
        const cardWidth = 280 + 40;

        function updateDots(index) {
            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === index);
            });
        }

        container.addEventListener('scroll', function() {
            const scrollLeft = this.scrollLeft;
            const index = Math.round(scrollLeft / cardWidth);
            if (index !== currentIndex && index < dots.length) {
                currentIndex = index;
                updateDots(index);
            }
        });

        dots.forEach((dot) => {
            dot.addEventListener('click', function() {
                const index = parseInt(this.getAttribute('data-index'));
                currentIndex = index;
                container.scrollTo({
                    left: index * cardWidth,
                    behavior: 'smooth'
                });
                updateDots(index);
            });
        });

        let resizeTimeout;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                const scrollLeft = container.scrollLeft;
                const index = Math.round(scrollLeft / cardWidth);
                if (index !== currentIndex && index < dots.length) {
                    currentIndex = index;
                    updateDots(index);
                }
            }, 100);
        });
    </script>
</body>
</html>
